        {
          "name": "Get Token - Client Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('spring_boot_access_token', response.access_token);",
                  "    console.log('✅ Token obtained');",
                  "} else { console.log('❌ Auth failed'); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{spring_boot_client_id}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{spring_boot_client_secret}}",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "{{spring_boot_scope}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{keycloak_url}}/realms/{{keycloak_realm}}/protocol/openid-connect/token",
              "host": [
                "{{keycloak_url}}"
              ],
              "path": [
                "realms",
                "{{keycloak_realm}}",
                "protocol",
                "openid-connect",
                "token"
              ]
            },
            "description": "Get access token using client credentials flow for Spring Boot application"
          },
          "response": []
        },
        {
          "name": "Get Token - Password Grant (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('user_access_token', response.access_token);",
                  "    pm.collectionVariables.set('spring_boot_access_token', response.access_token);",
                  "    ",
                  "    // Parse JWT to extract user info",
                  "    const token = response.access_token;",
                  "    const payload = JSON.parse(Buffer.from(token.split('.')[1], 'base64').toString());",
                  "    ",
                  "    // Set user variables for reporter",
                  "    pm.collectionVariables.set('current_username', payload.preferred_username);",
                  "    pm.collectionVariables.set('current_email', payload.email);",
                  "    ",
                  "    console.log('✅ Admin token obtained');",
                  "} else { console.log('❌ Auth failed'); }"
                ],
                "type": "text/javascript"
              }
