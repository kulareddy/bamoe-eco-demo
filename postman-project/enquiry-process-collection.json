          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('user_access_token', response.access_token);",
                  "    pm.collectionVariables.set('refresh_token', response.refresh_token);",
                  "    const token = response.access_token;",
                  "    const payload = JSON.parse(atob(token.split('.')[1]));",
                  "    pm.collectionVariables.set('current_username', payload.preferred_username);",
                  "    pm.collectionVariables.set('current_email', payload.email);",
                  "    console.log('\u2705 Admin token obtained');",
                  "    console.log('Username:', payload.preferred_username);",
                  "    console.log('Email:', payload.email);",
                  "    console.log('Groups:', payload.groups);",
                  "} else {",
                  "    console.log('\u274c Admin auth failed:', pm.response.text());",
                  "}"
                ]
              }
            }
