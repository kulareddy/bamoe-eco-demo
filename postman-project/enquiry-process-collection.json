{
  "info": {
    "name": "Enquiry Process Collection",
    "description": "Clean collection for Quarkus BAMOE Enquiry Process API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{user_access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "quarkus_base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "keycloak_base_url",
      "value": "http://localhost:9180",
      "type": "string"
    },
    {
      "key": "user_access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "current_username",
      "value": "",
      "type": "string"
    },
    {
      "key": "current_email",
      "value": "",
      "type": "string"
    },
    {
      "key": "enquiry_process_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get Token - Client Credentials",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "quarkus-bamoe-app"
                },
                {
                  "key": "client_secret",
                  "value": "quarkus-bamoe-secret"
                },
                {
                  "key": "scope",
                  "value": "openid profile email"
                }
              ]
            },
            "url": {
              "raw": "{{keycloak_base_url}}/realms/quarkus-realm/protocol/openid-connect/token",
              "host": [
                "{{keycloak_base_url}}"
              ],
              "path": [
                "realms",
                "quarkus-realm",
                "protocol",
                "openid-connect",
                "token"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('user_access_token', response.access_token);",
                  "    console.log('\u2705 Client credentials token obtained');",
                  "} else {",
                  "    console.log('\u274c Client credentials auth failed:', pm.response.text());",
                  "}"
                ]
              }
            }
          ]
        },
