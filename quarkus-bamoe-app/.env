# ===========================================
# Quarkus BAMOE Application Environment Configuration
# ===========================================

# ===========================================
# Service Ports
# ===========================================
MAVEN_REPO_PORT=9080
ZOOKEEPER_PORT=2181
KAFKA_PORT=9092
KEYCLOAK_PORT=9180
MANAGEMENT_CONSOLE_PORT=9280
KOGITO_SERVICE_PORT=8080
DB_PORT=5432

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=localhost
DB_NAME=enquiry-process
DB_USER=quarkus
DB_PASSWORD=quarkus
ENQUIRY_DB_NAME=enquiry-db

# ===========================================
# BAMOE Management Console Configuration
# ===========================================
BAMOE_MANAGEMENT_CONSOLE_APP_NAME=BAMOE Management Console
BAMOE_MANAGEMENT_CONSOLE_CLIENT_ID=bamoe-management-console
BAMOE_MANAGEMENT_CONSOLE_DEFAULT_SCOPES=openid email profile

# ===========================================
# Security Configuration (Keycloak)
# ===========================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
KEYCLOAK_REALM_NAME=quarkus-realm

# OIDC Configuration
OIDC_AUTH_SERVER_URL=http://localhost:9180/realms/quarkus-realm
OIDC_CLIENT_ID=quarkus-bamoe-app
OIDC_CLIENT_SECRET=quarkus-bamoe-secret
OAUTH_SCOPE=openid profile email

# ===========================================
# Kafka Configuration
# ===========================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=business-events
KAFKA_CONSUMER_GROUP=quarkus-bamoe-app

# ===========================================
# External Service Configuration
# ===========================================
ENQUIRY_SERVICE_URL=http://localhost:8081/api

# ===========================================
# Optional: Confluent Cloud Configuration
# ===========================================
# Uncomment and configure if using Confluent Cloud
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username="your-username" password="your-password";
