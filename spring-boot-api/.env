# OIDC Configuration for Development
OIDC_AUTH_SERVER_URL=http://localhost:9180/realms/quarkus-realm
OIDC_CLIENT_ID=spring-boot-api
OIDC_CLIENT_SECRET=spring-boot-api-secret
OAUTH_SCOPE=openid profile email
SPRING_SECURITY_OAUTH2_IDP_TYPE=keycloak

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=enquiry-db
DB_USER=quarkus
DB_PASSWORD=quarkus

# JPA Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
H2_CONSOLE_ENABLED=false

